<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Original Text</label>
      <textarea id="input-diff-orig" rows="6" class="w-full p-2 border border-slate-300 rounded text-xs font-mono"></textarea>
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Modified Text</label>
      <textarea id="input-diff-mod" rows="6" class="w-full p-2 border border-slate-300 rounded text-xs font-mono"></textarea>
    </div>
  </div>
  <button data-action="check" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Check Differences</button>

  <div class="mt-4">
    <label class="block text-xs font-bold text-slate-700 mb-1">Line-by-Line Diff Output</label>
    <div id="out-diff-result" class="p-3 bg-slate-50 border border-slate-300 rounded text-xs font-mono min-h-[100px] overflow-x-auto">-</div>
  </div>
</div>
