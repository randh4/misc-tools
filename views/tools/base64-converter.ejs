<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Input Data</label>
    <textarea id="input-b64-text" rows="4" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="Ketik atau paste teks..."></textarea>
  </div>
  <div class="flex space-x-2">
    <button data-action="convert" data-mode="encode" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Encode Base64</button>
    <button data-action="convert" data-mode="decode" class="px-4 py-2 bg-slate-700 text-white rounded text-xs font-bold hover:bg-slate-600">Decode Base64</button>
  </div>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Hasil Konversi</label>
      <button data-action="copy" data-target="#out-base64" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-base64" readonly rows="4" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
