<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">URL Target</label>
    <input type="text" id="input-http-url" value="https://httpbin.org/status/200" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="https://example.com">
  </div>
  <button data-action="check" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Inspect HTTP</button>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 text-xs">
    <div class="p-3 bg-slate-50 border rounded">
      <span class="text-slate-500 block">Status Code</span>
      <span id="out-http-status" class="text-base font-bold text-slate-900">-</span>
    </div>
    <div class="p-3 bg-slate-50 border rounded">
      <span class="text-slate-500 block">Response Time</span>
      <span id="out-http-time" class="text-base font-bold text-slate-900">-</span>
    </div>
  </div>

  <div class="mt-4">
    <label class="block text-xs font-bold text-slate-700 mb-1">Response Headers</label>
    <pre id="out-http-headers" class="p-3 bg-slate-50 border border-slate-300 rounded text-xs font-mono min-h-[100px] overflow-x-auto">-</pre>
  </div>
</div>
