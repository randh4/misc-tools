<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Docker Run Command</label>
    <textarea id="input-docker-run" rows="4" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="docker run -d --name my-redis -p 6379:6379 -v /data:/data redis:alpine"></textarea>
  </div>
  <button data-action="convert" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Convert to compose.yaml</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Docker Compose Output</label>
      <button data-action="copy" data-target="#out-docker-compose" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-docker-compose" readonly rows="8" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
