<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
      <label class="block text-xs font-bold text-slate-700 mb-1">Target Domain</label>
      <input type="text" id="input-dns-domain" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="example.com">
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Record Type</label>
      <select id="input-dns-type" class="w-full p-2 border border-slate-300 rounded text-xs">
        <option value="A">A (IPv4)</option>
        <option value="AAAA">AAAA (IPv6)</option>
        <option value="MX">MX (Mail)</option>
        <option value="TXT">TXT (Text)</option>
        <option value="NS">NS (Nameserver)</option>
        <option value="CNAME">CNAME (Alias)</option>
      </select>
    </div>
  </div>
  <button data-action="resolve" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Resolve DNS</button>

  <div class="mt-4">
    <label class="block text-xs font-bold text-slate-700 mb-1">Query Results</label>
    <pre id="out-dns-result" class="p-3 bg-slate-50 border border-slate-300 rounded text-xs font-mono min-h-[100px] overflow-x-auto">-</pre>
  </div>
</div>
