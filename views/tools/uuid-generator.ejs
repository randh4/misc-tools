<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Jumlah UUID (1 - 50)</label>
    <input type="number" id="input-uuid-qty" value="5" min="1" max="50" class="w-full p-2 border border-slate-300 rounded text-xs">
  </div>
  <button data-action="generate" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Generate UUIDs</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">UUID Output</label>
      <button data-action="copy" data-target="#out-uuid-list" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-uuid-list" readonly rows="6" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
