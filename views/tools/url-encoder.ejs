<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Input URL / Query</label>
    <textarea id="input-url-text" rows="3" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="https://example.com/search?q=test string"></textarea>
  </div>
  <div class="flex space-x-2">
    <button data-action="convert" data-mode="encode" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Encode URI</button>
    <button data-action="convert" data-mode="decode" class="px-4 py-2 bg-slate-700 text-white rounded text-xs font-bold hover:bg-slate-600">Decode URI</button>
  </div>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Hasil Konversi</label>
      <button data-action="copy" data-target="#out-url" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-url" readonly rows="3" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
