<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Raw SQL Query</label>
    <textarea id="input-sql" rows="5" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="SELECT u.id, u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id WHERE u.active = 1 ORDER BY o.total DESC;"></textarea>
  </div>
  <button data-action="format" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Format SQL</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Formatted SQL</label>
      <button data-action="copy" data-target="#out-sql" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-sql" readonly rows="8" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
