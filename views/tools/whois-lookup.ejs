<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Target Domain</label>
    <input type="text" id="input-whois-domain" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="example.com (tanpa https://)">
  </div>
  <button data-action="resolve" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Lookup WHOIS</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Raw WHOIS Response</label>
      <button data-action="copy" data-target="#out-whois-raw" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-whois-raw" readonly rows="10" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
