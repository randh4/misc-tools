<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Encoded JWT Token</label>
    <textarea id="input-jwt" rows="4" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="Paste JWT token (eyJh...)"></textarea>
  </div>
  <button data-action="convert" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Decode JWT</button>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <div class="flex justify-between items-center mb-1">
        <label class="text-xs font-bold text-slate-700">Decoded Header</label>
        <button data-action="copy" data-target="#out-jwt-header" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
      </div>
      <textarea id="out-jwt-header" readonly rows="8" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
    </div>
    <div>
      <div class="flex justify-between items-center mb-1">
        <label class="text-xs font-bold text-slate-700">Decoded Payload</label>
        <button data-action="copy" data-target="#out-jwt-payload" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
      </div>
      <textarea id="out-jwt-payload" readonly rows="8" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
    </div>
  </div>
</div>
