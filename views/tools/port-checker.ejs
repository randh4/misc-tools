<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Target Host / IP</label>
      <input type="text" id="input-port-host" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="e.g. 192.168.1.1 atau example.com">
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Target Port (1-65535)</label>
      <input type="number" id="input-port-num" value="80" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="80, 443, 22, 3306...">
    </div>
  </div>
  <button data-action="check" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Test Port</button>

  <div class="mt-4 p-4 bg-slate-50 border rounded text-xs">
    <div class="flex justify-between items-center">
      <span class="text-slate-500">Status Output:</span>
      <span id="out-port-status" class="font-bold">-</span>
    </div>
  </div>
</div>
