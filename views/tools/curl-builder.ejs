<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">HTTP Method</label>
      <select id="input-curl-method" class="w-full p-2 border border-slate-300 rounded text-xs">
        <option value="GET">GET</option>
        <option value="POST">POST</option>
        <option value="PUT">PUT</option>
        <option value="DELETE">DELETE</option>
        <option value="PATCH">PATCH</option>
      </select>
    </div>
    <div class="md:col-span-3">
      <label class="block text-xs font-bold text-slate-700 mb-1">Endpoint URL</label>
      <input type="text" id="input-curl-url" value="https://api.example.com/v1/resource" class="w-full p-2 border border-slate-300 rounded text-xs font-mono">
    </div>
  </div>
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Headers (Satu header per baris: Key: Value)</label>
    <textarea id="input-curl-headers" rows="2" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="Content-Type: application/json&#10;Authorization: Bearer ***"></textarea>
  </div>
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Body Payload</label>
    <textarea id="input-curl-body" rows="2" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="{}"></textarea>
  </div>
  <button data-action="generate" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Build cURL Command</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Generated Command</label>
      <button data-action="copy" data-target="#out-curl-cmd" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-curl-cmd" readonly rows="3" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
