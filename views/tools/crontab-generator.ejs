<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Cron Expression (5 parts: Minute Hour Day Month Weekday)</label>
    <input type="text" id="input-cron" value="*/15 * * * *" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder="* * * * *">
  </div>
  <div class="flex space-x-2">
    <button data-action="explain" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Explain Schedule</button>
  </div>

  <div class="mt-4 p-4 bg-slate-50 border rounded text-xs">
    <span class="text-slate-500 block mb-1">Schedule Meaning:</span>
    <p id="out-cron-desc" class="font-bold text-slate-800">-</p>
  </div>
</div>
