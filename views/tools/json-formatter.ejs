<div class="space-y-4">
  <div>
    <label class="block text-xs font-bold text-slate-700 mb-1">Input Raw JSON</label>
    <textarea id="input-json" rows="6" class="w-full p-2 border border-slate-300 rounded text-xs font-mono" placeholder='{"key":"value"}'></textarea>
  </div>
  <div class="flex space-x-2">
    <button data-action="format" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Format / Beautify</button>
    <button data-action="minify" class="px-4 py-2 bg-slate-700 text-white rounded text-xs font-bold hover:bg-slate-600">Minify JSON</button>
  </div>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Output JSON</label>
      <button data-action="copy" data-target="#out-json" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <textarea id="out-json" readonly rows="8" class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono"></textarea>
  </div>
</div>
