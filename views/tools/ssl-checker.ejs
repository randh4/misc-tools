<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
      <label class="block text-xs font-bold text-slate-700 mb-1">Hostname / Domain</label>
      <input type="text" id="input-host" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="e.g. google.com">
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Port</label>
      <input type="number" id="input-port" value="443" class="w-full p-2 border border-slate-300 rounded text-xs">
    </div>
  </div>
  <button data-action="check" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Check Certificate</button>

  <div class="mt-4 border-t border-slate-200 pt-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="p-3 bg-slate-50 border rounded">
        <span class="text-slate-500 block">Valid Until</span>
        <span id="out-ssl-valid-to" class="font-bold">-</span>
      </div>
      <div class="p-3 bg-slate-50 border rounded">
        <span class="text-slate-500 block">Days Remaining</span>
        <span id="out-ssl-days" class="font-bold">-</span>
      </div>
      <div class="p-3 bg-slate-50 border rounded">
        <span class="text-slate-500 block">Issuer</span>
        <span id="out-ssl-issuer" class="font-bold">-</span>
      </div>
    </div>
    <div class="mt-3 p-3 bg-slate-50 border rounded text-xs">
      <span class="text-slate-500 block">Subject Alternative Names (SAN)</span>
      <span id="out-ssl-san" class="font-mono text-xs break-all">-</span>
    </div>
  </div>
</div>
