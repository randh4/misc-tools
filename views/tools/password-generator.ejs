<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Panjang Karakter</label>
      <input type="number" id="input-length" value="20" min="6" max="128" class="w-full p-2 border border-slate-300 rounded text-xs">
    </div>
    <div class="flex items-center space-x-4 pt-5">
      <label class="inline-flex items-center text-xs">
        <input type="checkbox" id="chk-symbols" checked class="mr-2"> Simbol (!@#$...)
      </label>
      <label class="inline-flex items-center text-xs">
        <input type="checkbox" id="chk-numbers" checked class="mr-2"> Angka (0-9)
      </label>
    </div>
  </div>
  <button data-action="generate" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Generate Password</button>

  <div class="mt-4">
    <div class="flex justify-between items-center mb-1">
      <label class="text-xs font-bold text-slate-700">Hasil Password</label>
      <button data-action="copy" data-target="#out-password" class="text-xs text-slate-500 hover:text-slate-900">Copy</button>
    </div>
    <input type="text" id="out-password" readonly class="w-full p-2 bg-slate-50 border border-slate-300 rounded text-xs font-mono">
  </div>
</div>
