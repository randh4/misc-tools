<div class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
      <label class="block text-xs font-bold text-slate-700 mb-1">Target Host / IP</label>
      <input type="text" id="input-ping-host" class="w-full p-2 border border-slate-300 rounded text-xs" placeholder="e.g. 1.1.1.1 atau google.com">
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Port (TCP)</label>
      <input type="number" id="input-ping-port" value="80" class="w-full p-2 border border-slate-300 rounded text-xs">
    </div>
  </div>
  <button data-action="check" class="px-4 py-2 bg-slate-900 text-white rounded text-xs font-bold hover:bg-slate-800">Send Ping Probe</button>

  <div class="mt-4 p-4 bg-slate-50 border rounded text-xs">
    <div class="flex justify-between items-center mb-2">
      <span class="text-slate-500">Reachability Status:</span>
      <span id="out-ping-status" class="font-bold">-</span>
    </div>
    <div class="flex justify-between items-center">
      <span class="text-slate-500">Round-Trip Latency:</span>
      <span id="out-ping-latency" class="font-bold">-</span>
    </div>
  </div>
</div>
