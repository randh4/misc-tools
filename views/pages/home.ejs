<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full">
  <!-- Title & Count Header -->
  <div class="mb-6 border-b border-slate-300 pb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
        <span class="text-emerald-600 font-mono font-bold">&gt;_</span>
        <span>IT ENGINEER TOOLBOX</span>
      </h1>
      <p class="text-slate-600 text-sm mt-2 leading-relaxed max-w-4xl">Satu Ruang Kerja untuk Semua Kebutuhan Teknis. Hentikan kebiasaan tab-switching yang melelahkan. IT Engineer Toolbox mengumpulkan seluruh utilitas, skrip, dan alat esensial harian dalam satu platform praktis yang dikelompokkan presisi sesuai alur kerja teknik kamu.</p>
    </div>
    <div class="text-right">
      <span id="visible-count" class="inline-block px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-semibold border border-slate-300 transition-all">
        <%= tools.length %> utilitas
      </span>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 rounded bg-red-100 text-red-800 border border-red-300 text-sm"><%= error %></div>
  <% } %>

  <!-- Search Input Bar -->
  <div class="relative mb-6">
    <input type="text" id="search-input" placeholder="🔍 Cari utilitas berdasarkan nama atau deskripsi..." class="w-full pl-10 pr-4 py-3 text-xs md:text-sm bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all">
    <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
  </div>

  <!-- Filter Pills Bar -->
  <div class="mb-8 flex flex-wrap gap-2">
    <button type="button" data-category="all" aria-selected="true" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-emerald-600 text-white border-emerald-600 shadow-sm active:scale-95">
      Semua Tools (<%= tools.length %>)
    </button>
    <button type="button" data-category="network" aria-selected="false" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-white text-slate-600 border-slate-300 hover:bg-slate-50 active:scale-95">
      🌐 Network (<%= tools.filter(t => t.category.toLowerCase() === 'network').length %>)
    </button>
    <button type="button" data-category="security" aria-selected="false" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-white text-slate-600 border-slate-300 hover:bg-slate-50 active:scale-95">
      🛡️ Security (<%= tools.filter(t => t.category.toLowerCase() === 'security').length %>)
    </button>
    <button type="button" data-category="crypto-encoding" aria-selected="false" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-white text-slate-600 border-slate-300 hover:bg-slate-50 active:scale-95">
      🔑 Crypto & Encoding (<%= tools.filter(t => ['crypto', 'encoding'].includes(t.category.toLowerCase())).length %>)
    </button>
    <button type="button" data-category="formatters-converters" aria-selected="false" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-white text-slate-600 border-slate-300 hover:bg-slate-50 active:scale-95">
      🔄 Formatters & Converters (<%= tools.filter(t => ['formatter', 'converter'].includes(t.category.toLowerCase())).length %>)
    </button>
    <button type="button" data-category="devops-system" aria-selected="false" class="cat-filter-btn px-4 py-2 text-xs font-bold rounded-lg border transition-all duration-200 bg-white text-slate-600 border-slate-300 hover:bg-slate-50 active:scale-95">
      ⚡ DevOps & System (<%= tools.filter(t => ['devops', 'system', 'utilities'].includes(t.category.toLowerCase())).length %>)
    </button>
  </div>

  <!-- Tools Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tools-grid">
    <% tools.forEach(t => { %>
      <a href="/tools/<%= t.slug %>" data-category="<%= t.category.toLowerCase() %>" class="tool-card block p-5 bg-white rounded-lg border border-slate-200 hover:border-emerald-500 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200"><%= t.category %></span>
          <%- include('../partials/privacy-badge', { privacy: t.privacy }) %>
        </div>
        <h2 class="text-base font-bold text-slate-800 group-hover:text-emerald-600 transition-colors"><%= t.name %></h2>
        <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed"><%= t.desc %></p>
      </a>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>
